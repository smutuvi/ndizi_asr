# Required: OpenRouter API key (https://openrouter.ai/keys)
# Needed only for OpenRouter models (google/gemini-*). Not required for local Sunbird.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# HF_TOKEN=hf_xxxxxxxx   # required to download gated models like Sunbird/asr-whisper-51-african-languages
# HF_HOME=.hf_cache
