# Required for OpenRouter Gemini models
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Required for gated local models (Sunbird Whisper-51):
# 1) Visit https://huggingface.co/Sunbird/asr-whisper-51-african-languages and accept access
# 2) Create a token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxx

# Optional overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# HF_HOME=.hf_cache
