# Required for OpenRouter Gemini models
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Required for gated local models (Sunbird Whisper-51 / Gemma):
# 1) Accept model terms on Hugging Face
# 2) Create a token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxx

# Optional — Meta Omnilingual ASR local checkout
# OMNILINGUAL_ASR_ROOT=/path/to/omnilingual-asr

# Optional overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# HF_HOME=.hf_cache
